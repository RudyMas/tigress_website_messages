{% extends 'datatable.twig' %}
{% block js %}
    {{ parent() }}
    <script>
        let variables = {
            access: '{{ rights.access }}',
            read: '{{ rights.read }}',
            write: '{{ rights.write }}',
            delete: '{{ rights.delete }}',
            show: '{{ _GET.show }}',
        }
        let language = {
            translations: {{ translations|json_encode|raw }},
        }
    </script>
    <script src="{{ BASE_URL }}/vendor/tigress/website-messages/public/javascript/website_messages/index.js?vs=20260917-0"></script>
{% endblock %}
{% block title %}{{ __('Website Messages') }}{% endblock %}
{% block breadcrumb %}
    <div class="row mb-2">
        <div class="col-md-12">
            <nav aria-label="breadcrumb" data-bs-theme="{{ WEBSITE.mode }}">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/home"><i class="fa fa-home"></i></a></li>
                    <li class="breadcrumb-item active">{{ __('Website Messages') }}</li>
                </ol>
            </nav>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="container">
        <div class="row mb-2">
            <div class="col-md-8">
                <h3>{{ __('Website Messages') }}
                    {% if (toegang) %}
                        <a class="btn btn-sm btn-outline-light" href="{{ BASE_URL }}/website-messages/settings">
                            <i class="fa-solid fa-sliders"></i>
                        </a>
                    {% endif %}
                </h3>
            </div>
            <div class="col-md-4 text-end">
                {% if _GET.show == 'archive' %}
                    <a href="{{ BASE_URL }}/website-messages" class="btn btn-warning mb-1"><i
                                class="fa-solid fa-archive"></i> {{ __('Archive') }}</a>
                {% else %}
                    <a href="{{ BASE_URL }}/website-messages?show=archive" class="btn btn-outline-warning mb-1"><i
                                class="fa-solid fa-archive"></i> {{ __('Archive') }}</a>
                {% endif %}
                {% if rights.write %}
                    <a href="{{ BASE_URL }}/website-messages/edit/0" class="btn btn-success mb-1"><i class="fa-solid fa-plus"></i>
                        {{ __('Add') }}</a>
                {% endif %}
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-12">
                <fieldset class="mt-2">
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <div class="table-responsive">
                                <table id="dataTableWebsiteMessages"
                                       class="table table-striped table-bordered w-100"></table>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    {# Modal Confirm Archive Website Message #}
    <div class="modal fade" id="confirmArchiveWebsiteMessageModal" tabindex="-1" aria-labelledby="confirmArchiveWebsiteMessageLabel"
         aria-hidden="true" style="color: black">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmArchiveWebsiteMessageLabel">{{ __('Archive Website Message') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
                </div>
                <div class="modal-body">
                    <p>{{ __('Are you sure you want to archive this Website Message?') }}</p>
                </div>
                <div class="modal-footer">
                    <a href="#" id="confirmArchiveWebsiteMessageBtn" class="btn btn-success">{{ __('Archiving') }}</a>
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">{{ __('Cancel') }}</button>
                </div>
            </div>
        </div>
    </div>

    {# Modal Confirm Delete Website Message #}
    <div class="modal fade" id="confirmDeleteWebsiteMessageModal" tabindex="-1" aria-labelledby="confirmDeleteWebsiteMessageLabel"
         aria-hidden="true" style="color: black">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteWebsiteMessageLabel">{{ __('Delete Website Message') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
                </div>
                <div class="modal-body">
                    <p>{{ __('Are you sure you want to delete this Website Message?') }}</p>
                    {# Maak een warning box #}
                    <p class="alert alert-warning" role="alert">{{ __('This action cannot be undone.') }}</p>
                </div>
                <div class="modal-footer">
                    <a href="#" id="confirmDeleteWebsiteMessageBtn" class="btn btn-success">{{ __('Deleting') }}</a>
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">{{ __('Cancel') }}</button>
                </div>
            </div>
        </div>
    </div>

    {# Modal Confirm Restore Website Message #}
    <div class="modal fade" id="confirmRestoreWebsiteMessageModal" tabindex="-1" aria-labelledby="confirmRestoreWebsiteMessageLabel"
         aria-hidden="true" style="color: black">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmRestoreWebsiteMessageLabel">{{ __('Restore Website Message') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
                </div>
                <div class="modal-body">
                    <p>{{ __('Are you sure you want to restore this Website Message?') }}</p>
                </div>
                <div class="modal-footer">
                    <a href="#" id="confirmRestoreWebsiteMessageBtn" class="btn btn-success">{{ __('Restoring') }}</a>
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">{{ __('Cancel') }}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}